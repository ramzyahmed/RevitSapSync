<Window x:Class="RevitSapSync.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RevitSapSync" Height="640" Width="960" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Read SAP Model" Command="{Binding ReadSapModelCommand}" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="Read Revit Model" Command="{Binding ReadRevitModelCommand}" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="Map" Command="{Binding RunMappingCommand}" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="Sync Sections" Command="{Binding SyncSectionsCommand}" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="Sync Geometry" Command="{Binding SyncGeometryCommand}" Padding="12,5" Margin="0,0,8,0" />
            <Button Content="Cancel" Command="{Binding CancelCurrentOperationCommand}" Padding="12,5" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Border Background="#DFF5E1" Padding="12,6" Margin="0,0,8,0" CornerRadius="4" MinWidth="110">
                <StackPanel>
                    <TextBlock Text="Mapped" FontSize="11" Foreground="#2E7D32" />
                    <TextBlock Text="{Binding MappedCount}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="#FDECEA" Padding="12,6" Margin="0,0,8,0" CornerRadius="4" MinWidth="110">
                <StackPanel>
                    <TextBlock Text="Unmapped SAP" FontSize="11" Foreground="#C62828" />
                    <TextBlock Text="{Binding UnmappedSapCount}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="#FDECEA" Padding="12,6" Margin="0,0,8,0" CornerRadius="4" MinWidth="110">
                <StackPanel>
                    <TextBlock Text="Unmapped Revit" FontSize="11" Foreground="#C62828" />
                    <TextBlock Text="{Binding UnmappedRevitCount}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
            <Border Background="#FFF8E1" Padding="12,6" CornerRadius="4" MinWidth="110">
                <StackPanel>
                    <TextBlock Text="Ambiguous" FontSize="11" Foreground="#F9A825" />
                    <TextBlock Text="{Binding AmbiguousCount}" FontSize="20" FontWeight="Bold" />
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="{Binding StatusText}" Margin="0,0,0,4" />
            <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="6"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding MappingRows}" AutoGenerateColumns="False"
                  IsReadOnly="True" CanUserAddRows="False" CanUserSortColumns="True" GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SAP ID" Binding="{Binding SapId}" Width="90" />
                <DataGridTextColumn Header="SAP Type" Binding="{Binding SapMemberType}" Width="110" />
                <DataGridTextColumn Header="Revit Element Id" Binding="{Binding RevitElementId}" Width="120" />
                <DataGridTextColumn Header="Revit Type" Binding="{Binding RevitMemberType}" Width="110" />
                <DataGridTextColumn Header="SAP Length" Binding="{Binding SapLength, StringFormat={}{0:F1}}" Width="90" />
                <DataGridTextColumn Header="Revit Length" Binding="{Binding RevitLength, StringFormat={}{0:F1}}" Width="90" />
                <DataGridTextColumn Header="Length Delta %" Binding="{Binding LengthDeltaPercent, StringFormat={}{0:F1}}" Width="100" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="170" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
